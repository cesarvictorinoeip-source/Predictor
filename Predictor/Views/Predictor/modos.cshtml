@model IEnumerable<Predictor.Controllers.PredictorView>

@{
    ViewData["Title"] = "Modos";
}

<div class="container mt-5 text-center">
    <h1 class="display-6">Selecciona el modo de predicción</h1>
    <p class="text-muted">Elige el algoritmo que deseas usar para analizar la tendencia del activo.</p>

    <div class="row justify-content-center mt-4">
        <div class="col-md-6 text-start">
            
            <form asp-action="GuardarModo" method="post">
                <label class="form-label fw-bold">Modo de predicción:</label>

                <select class="form-select shadow-sm mb-4" name="modoSeleccionado" id="modoSelector" required>
                    <option selected disabled value="">-- Seleccione un algoritmo --</option>
                    @foreach (var item in Model)
                    {
                        <option value="@item.Modo">@item.Modo</option>
                    }
                </select>

                <div class="text-center">
                    <button type="submit" class="btn btn-primary px-5 shadow-sm">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>